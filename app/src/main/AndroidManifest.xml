<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value="io.github.supermonster003.autojs6.plugin.lua.runtime.WakeActivity" />

        <activity
            android:name="io.github.supermonster003.autojs6.plugin.lua.runtime.WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.LuaPluginInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="lua-runtime" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/lua_runtime_requires_host_version" />
        </service>

        <service
            android:name=".service.LuaRuntimeService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:process=":lua_runtime">
            <intent-filter>
                <action android:name="org.autojs.plugin.lua.RUNTIME" />
                <category android:name="lua54" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/lua_runtime_requires_host_version" />
        </service>

    </application>

</manifest>
